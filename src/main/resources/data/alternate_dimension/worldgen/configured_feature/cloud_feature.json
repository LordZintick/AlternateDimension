{
  "type": "minecraft:disk",
  "config": {
    "radius": 8,
    "half_height": 1,
    "target": {
      "type": "minecraft:matching_blocks",
      "blocks": "minecraft:air"
    },
    "state_provider": {
      "fallback": {
        "type": "minecraft:simple_state_provider",
        "state": {
          "Name": "alternate_dimension:cloud_block"
        }
      },
      "rules": [
        {
          "if_true": {
            "type": "minecraft:matching_blocks",
            "blocks": "minecraft:air"
          },
          "then": {
            "type": "minecraft:simple_state_provider",
            "state": {
              "Name": "alternate_dimension:cloud_block"
            }
          }
        },
        {
          "if_true": {
            "type": "minecraft:not",
            "predicate": {
              "type": "minecraft:matching_blocks",
              "blocks": "minecraft:air"
            }
          },
          "then": {
            "type": "minecraft:simple_state_provider",
            "state": {
              "Name": "minecraft:snow_block"
            }
          }
        }
      ]
    }
  }
}