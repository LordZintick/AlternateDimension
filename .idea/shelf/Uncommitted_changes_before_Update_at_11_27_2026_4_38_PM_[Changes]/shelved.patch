n    <task active=\"true\" id=\"Default\" summary=\"Default task\">\r\n      <changelist id=\"d63c5b1c-e49b-4b76-859e-577c435bcbf8\" name=\"Changes\" comment=\"\" />\r\n      <created>1749899385930</created>\r\n      <option name=\"number\" value=\"Default\" />\r\n      <option name=\"presentableId\" value=\"Default\" />\r\n      <updated>1749899385930</updated>\r\n    </task>\r\n    <task id=\"LOCAL-00001\" summary=\"- Finished implementing Hallowed one and made Void and Hallowed mobs attack each other.&#10;- Added some new Hallowed items.&#10;- Removed vanilla mobs &amp; structures from biome spawn lists.&#10;- Made Elves and Corrupted Elves attack each other.&#10;- Added the first five AltDim OST tracks: Fallen Hero, Lost Ruins, Outcast, Fading Away, and Final Struggle.&#10;- Converted more vanilla blocks/items to custom versions.&#10;- Added &amp; fixed custom crafting tables for different woods.&#10;- Added Romans, Vikings, their drops, and their reputation mechanic.&#10;- Added wooden tools for all wood types.&#10;- Added Phosphorium and Phosphorium Tools.&#10;- Rebalanced ore generation.&#10;- Added custom furnaces for each strata type.&#10;- Migrated glass and bowls over to custom ones.&#10;- Added new mobs and structures.&#10;- Tweaked recipes and loot tables to further migrate away from vanilla blocks and items.&#10;- Added more custom alternatives for vanilla stuff.&#10;- Added (buggy) aluminum buckets.&#10;- Added decorative platform blocks.&#10;- Added Beetle Queen and beetle variants, as well as the Scorched Tower.&#10;- Fixed many bugs\">\r\n      <option name=\"closed\" value=\"true\" />\r\n      <created>1781991173438</created>\r\n      <option name=\"number\" value=\"00001\" />\r\n      <option name=\"presentableId\" value=\"LOCAL-00001\" />\r\n      <option name=\"project\" value=\"LOCAL\" />\r\n      <updated>1781991173438</updated>\r\n    </task>\r\n    <task id=\"LOCAL-00002\" summary=\"- Deleted Ice Cream Hills &amp; Candy Forest Biomes&#10;- Deleted Sugar Blocks and Chocolate Bar&#10;- Somewhat fixed the candy jetpack&#10;- Made some changes to worldgen&#10;- Fixed the Roman Spear&#10;- Added Shroomium Tools and made Shroomium Ore only breakable with mushy tools.&#10;- Added Graphite Rod.&#10;- Added Bow Utility procedures.&#10;- Added Planet Core.&#10;- Various minor changes and fixes.\">\r\n      <option name=\"closed\" value=\"true\" />\r\n      <created>1782468961417</created>\r\n      <option name=\"number\" value=\"00002\" />\r\n      <option name=\"presentableId\" value=\"LOCAL-00002\" />\r\n      <option name=\"project\" value=\"LOCAL\" />\r\n      <updated>1782468961417</updated>\r\n    </task>\r\n    <task id=\"LOCAL-00003\" summary=\"- Did a full refactor after merging from remote dev.&#10;- Fully fixed Instatunnel and added Instavator.&#10;- Added textures for pulling stages of Scorched Bow.&#10;- Made Umberflower generate naturally, and made a recipe to convert it to black dye.&#10;- Added Possessed Armor entity.&#10;- Added stone-tier tools for shale, veridium, and mantle.&#10;- Made various changes and fixes after the first playtest.&#10;- Added the Greenwood wood set.\">\r\n      <option name=\"closed\" value=\"true\" />\r\n      <created>1783084682781</created>\r\n      <option name=\"number\" value=\"00003\" />\r\n      <option name=\"presentableId\" value=\"LOCAL-00003\" />\r\n      <option name=\"project\" value=\"LOCAL\" />\r\n      <updated>1783084682781</updated>\r\n    </task>\r\n    <task id=\"LOCAL-00004\" summary=\"- Added the Spore Spreader mob and Shroomy Infection effect.&#10;- Made rings dynamic rather than hardcoded and made a dynamic data component/recipe manager for them.&#10;- Fixed the spawning of many mobs and the Ability goals.&#10;- Various other minor fixes and changes.\">\r\n      <option name=\"closed\" value=\"true\" />\r\n      <created>1783265617436</created>\r\n      <option name=\"number\" value=\"00004\" />\r\n      <option name=\"presentableId\" value=\"LOCAL-00004\" />\r\n      <option name=\"project\" value=\"LOCAL\" />\r\n      <updated>1783265617436</updated>\r\n    </task>\r\n    <task id=\"LOCAL-00005\" summary=\"- Refactored workspace to 2026.2 and Minecraft Neoforge 26.1.2.&#10;- Added many zombie variants.&#10;- Added the Blood Moon and support for other world events.&#10;- Other various minor fixes and changes.\">\r\n      <option name=\"closed\" value=\"true\" />\r\n      <created>1783891576734</created>\r\n      <option name=\"number\" value=\"00005\" />\r\n      <option name=\"presentableId\" value=\"LOCAL-00005\" />\r\n      <option name=\"project\" value=\"LOCAL\" />\r\n      <updated>1783891576734</updated>\r\n    </task>\r\n    <task id=\"LOCAL-00006\" summary=\"- Added many new materials and items, including Mana Stones, Mana Crystals, and tech components like Mana Coils and Circuits, importers, exporters, and drivetrain belts.&#10;- Completely deleted the old machine system and reimplemented a new, better, more user- and automation-friendly system based around &quot;mana.&quot;&#10;- Added two new structures to partly replace the deleted Pasta Mall.&#10;- Removed the Hexagem Complex and derivatives.&#10;- Made the recipes for the high-tier math weapons harder to get, requiring Aluminum and/or Mana Stones&#10;- Added physical blocks for Lemons and Limes, and made them and the Pear growth generate on Lush Forest trees and a new Fruit tree in the Fruity Gardens&#10;- Half-implemented the Blue Moon event - no special moon texture yet, but blue fog.&#10;- Buffed the portal wand recipe.&#10;- Added four new gems with their own gem blocks&#10;- Added the Iron Giant boss.&#10;- Added the Crude Salve and Crude Bandage&#10;- Added flesh drops for all the new zombie variants&#10;- Added two new flowers: the Cheeseflower and Magister's Bloom&#10;- Added Evilstone and Holystone tools, which give damage buffs to Hallowed and Void mobs, respectively.&#10;- Added three new spider variants: the Hydra, Venomous, and Incendiary spiders, each with their own special abilities.&#10;- Added the wooden club and a simple upgrade using venom glands, another new item.&#10;- Finally implemented a graphite rod recipe.&#10;- Added a Gem ore that drops a random gem, rather than the geodes (which were deleted)&#10;- Finally added a use for corn: Popcorn!&#10;- Many, many, many other minor fixes and changes.\">\r\n      <option name=\"closed\" value=\"true\" />\r\n      <created>1785073179667</created>\r\n      <option name=\"number\" value=\"00006\" />\r\n      <option name=\"presentableId\" value=\"LOCAL-00006\" />\r\n      <option name=\"project\" value=\"LOCAL\" />\r\n      <updated>1785073179667</updated>\r\n    </task>\r\n    <task id=\"LOCAL-00007\" summary=\"- Fixed a significant bug with gravestones and death.&#10;- Made some minor changes to creative tab icons.&#10;- Removed the choice for vanilla - AltDim mode is now the only mode.\">\r\n      <option name=\"closed\" value=\"true\" />\r\n      <created>1787054416060</created>\r\n      <option name=\"number\" value=\"00007\" />\r\n      <option name=\"presentableId\" value=\"LOCAL-00007\" />\r\n      <option name=\"project\" value=\"LOCAL\" />\r\n      <updated>1787054416060</updated>\r\n    </task>\r\n    <task id=\"LOCAL-00008\" summary=\"- Various minor changes and fixes.\">\r\n      <option name=\"closed\" value=\"true\" />\r\n      <created>1787055418792</created>\r\n      <option name=\"number\" value=\"00008\" />\r\n      <option name=\"presentableId\" value=\"LOCAL-00008\" />\r\n      <option name=\"project\" value=\"LOCAL\" />\r\n      <updated>1787055418792</updated>\r\n    </task>\r\n    <task id=\"LOCAL-00009\" summary=\"- Deleted the scorched bow because it was causing problems.\">\r\n      <option name=\"closed\" value=\"true\" />\r\n      <created>1787057748295</created>\r\n      <option name=\"number\" value=\"00009\" />\r\n      <option name=\"presentableId\" value=\"LOCAL-00009\" />\r\n      <option name=\"projec